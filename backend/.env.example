# ─────────────────────────────────────────────────────────────────────────
# backend/.env.example
#
# 이 파일을 backend/.env 로 복사해서 쓴다.
#   cp backend/.env.example backend/.env
#
# .env 는 .gitignore 에 있어 커밋되지 않는다.
# 실제 비밀번호나 API 키를 이 example 파일에 넣지 말 것.
#
# .env 를 고치면 백엔드를 수동 재시작해야 한다
# (--watch 는 소스만 감시하고 .env 는 시작 시 한 번만 읽는다).
# ─────────────────────────────────────────────────────────────────────────


# ── 로그인 계정 (필수) ───────────────────────────────────────────────────
# 형식: 이메일:비밀번호:그룹|그룹   (쉼표로 여러 계정)
# 그룹은 생략 가능. admin 그룹이면 헤더에 admin 배지가 붙는다.
#
# 코드에 기본 계정이 없으므로 지정하지 않으면 아무도 로그인할 수 없다.
# 아래 placeholder 를 실제 이메일·비밀번호로 바꿔 쓴다.
AUTH_USERS=admin@example.com:change-me:admin

# 로그인 유지 시간 (기본 12시간). 요청마다 갱신된다.
# AUTH_SESSION_TTL_MS=43200000

# 세션 쿠키 이름
# AUTH_COOKIE_NAME=interview_session

# HTTPS 뒤에 둘 때만 true
# AUTH_COOKIE_SECURE=false


# ──────────────────────────────────────────────────────────────────────
# 선택 / 향후 LLM 연동
#
# 현재 버전에서는 사용하지 않는다.
# 주제 나누기는 외부 LLM API를 호출하지 않으며, 코드가 아래 값을 읽지 않는다.
# (전체인터뷰.txt + 프롬프트를 사용자가 Claude에 직접 첨부하는 방식)
#
# 향후 자동 주제 분석을 붙이게 되면 그때 아래를 활성화한다.
# ──────────────────────────────────────────────────────────────────────
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=


# ── 서버 · 저장소 (선택) ─────────────────────────────────────────────────
# PORT=4000

# 임시 파일 루트. 영구 저장소가 아니다.
# STORAGE_ROOT=./storage

# 파일당 업로드 상한 (기본 4 GB)
# MAX_UPLOAD_BYTES=4294967296

# 한 번에 올릴 수 있는 파일 개수
# MAX_FILES_PER_UPLOAD=50

# 세션 보관 시간 — 마지막 접근 기준 (기본 6시간)
# SESSION_TTL_MS=21600000

# 청소 주기 (기본 10분)
# SWEEP_INTERVAL_MS=600000

# 음성 변환 성공 후 원본 영상 삭제
# DELETE_SOURCE_AFTER_EXTRACT=true

# 동시 음성 변환 개수 (기본 1 = 순차)
# EXTRACT_CONCURRENCY=1


# ── 외부 실행 파일 · 모델 (선택) ─────────────────────────────────────────
# ffmpeg 를 PATH 가 아닌 곳에 설치했을 때
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# 받아쓰기 워커용 파이썬 (기본: backend/python/.venv/bin/python)
# PYTHON_PATH=./python/.venv/bin/python

# 받아쓰기 모델. 첫 실행 시 약 3 GB 를 내려받는다.
# WHISPER_MODEL=large-v3

# 워커가 유휴 상태로 이 시간을 넘기면 종료 (기본 30분)
# TRANSCRIBER_IDLE_MS=1800000

# 모델 로딩 대기 한도 — 첫 실행은 모델 다운로드 포함 (기본 30분)
# TRANSCRIBER_STARTUP_MS=1800000

# 아래는 보통 건드리지 않는다 (파이썬 워커가 직접 읽음)
# WHISPER_LANGUAGE=ko
# WHISPER_BEAM_SIZE=5
# WHISPER_VAD_FILTER=true
# WHISPER_DEVICE=            # cuda | cpu — 비워 두면 자동 판정
# WHISPER_COMPUTE_TYPE=      # float16 | int8 — 비워 두면 자동
