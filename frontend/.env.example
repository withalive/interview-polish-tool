# 로컬 개발은 비워 둔다. /api 요청을 Vite가 백엔드로 프록시한다.
# GitHub Pages에서는 저장소 Settings → Secrets and variables → Actions → Variables에
# VITE_API_BASE_URL을 등록한 뒤 다시 배포한다. /api까지 포함한 HTTPS 주소를 쓴다.
# 예: https://api.example.com/api (실제 배포한 서버 주소로 교체)
VITE_API_BASE_URL=

# VITE_ 값은 브라우저에 공개된다. 계정/비밀번호/API 키는 backend에만 둔다.
